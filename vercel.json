{
  "version": 2,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS, PUT, DELETE" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-ERP-Token, X-FN-Token, X-Requested-With, Cache-Control" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/insumos.php", "destination": "/api/insumos" }
  ]
}
